  "item": [
    {
      "name": "1. POST /base/oauth/token",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const ts=Math.floor(Date.now()/1000).toString();pm.environment.set('timestamp',ts);",
              "pm.environment.set('sign',CryptoJS.MD5(pm.environment.get('client_id')+pm.environment.get('client_secret')+ts).toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b=pm.response.json();",
              "pm.test('errcode = 0000',()=>pm.expect(b.errcode).to.eql('0000'));",
              "pm.environment.set('access_token',b.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_id\": \"{{client_id}}\",\n  \"timestamp\": \"{{timestamp}}\",\n  \"sign\": \"{{sign}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/base/oauth/token",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "base",
            "oauth",
            "token"
          ]
        }
      }
    },
    {
      "name": "2. EBM INV2507-296_20250715_103429",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('fileHash','668b0a066c1089496038376936c4375a');",
              "pm.variables.set('expectPages','1');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b=pm.response.json();",
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('errcode = 0000',()=>pm.expect(b.errcode).to.eql('0000'));",
              "pm.test('description = Success',()=>pm.expect(b.description).to.eql('Success'));",
              "pm.test('顶层字段与生产一致',()=>pm.expect(Object.keys(b).sort()).to.eql(['data','description','docPages','errcode','traceId']));",
              "pm.test('traceId 16 位十六进制',()=>pm.expect(b.traceId).to.match(/^[0-9a-f]{16}$/));",
              "pm.test('docPages 与实际页数一致',()=>pm.expect(b.docPages).to.eql(Number(pm.variables.get('expectPages'))));",
              "pm.test('data 非空',()=>pm.expect(b.data.length).to.be.above(0));",
              "b.data.forEach((e,i)=>{",
              "  pm.test(`票据${i+1}: header 五分组`,()=>pm.expect(Object.keys(e.header)).to.eql(['basic','billTo','billFrom','bussiness','payment']));",
              "  pm.test(`票据${i+1}: detail 三分组`,()=>pm.expect(Object.keys(e.detail)).to.eql(['detailOfGoodsOrServices','detailOfTaxSummary','originalInvoiceReferences']));",
              "  pm.test(`票据${i+1}: 字段全集(12/14/14/6/7)`,()=>{pm.expect(Object.keys(e.header.basic).length).to.eql(12);pm.expect(Object.keys(e.header.billTo).length).to.eql(14);pm.expect(Object.keys(e.header.billFrom).length).to.eql(14);pm.expect(Object.keys(e.header.bussiness).length).to.eql(6);pm.expect(Object.keys(e.header.payment).length).to.eql(7);});",
              "  pm.test(`票据${i+1}: 标量均为字符串`,()=>{for(const g of ['basic','billTo','billFrom','bussiness','payment']){for(const [k,v] of Object.entries(e.header[g])){if(k==='page'){pm.expect(Array.isArray(v)).to.be.true;}else{pm.expect(typeof v,g+'.'+k).to.eql('string');}}}});",
              "  pm.test(`票据${i+1}: sourceFileHash 回填`,()=>pm.expect(e.header.basic.sourceFileHash).to.eql(pm.variables.get('fileHash')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "client-platform",
            "value": "common"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "templateId",
              "value": "7",
              "type": "text"
            },
            {
              "key": "fileHash",
              "value": "{{fileHash}}",
              "type": "text"
            },
            {
              "key": "clientId",
              "value": "{{client_id}}",
              "type": "text"
            },
            {
              "key": "file",
              "type": "file",
              "src": "/Users/shaobin/Desktop/project/API_anything/testing/EBM INV2507-296_20250715_103429.pdf"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/ai/knowledge/nlpService/document/analyze?access_token={{access_token}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "ai",
            "knowledge",
            "nlpService",
            "document",
            "analyze"
          ],
          "query": [
            {
              "key": "access_token",
              "value": "{{access_token}}"
            }
          ]
        }
      }
