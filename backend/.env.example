
# ── MyInvois（马来西亚税局）查验增强 ────────────────────────────────────
# 路径：PDF 二维码 → uuid → 网关 /v1/invoices/verify（返回税局原始 UBL）
#       → 与 OCR 消融（税局恒优先）。票面无二维码则直接走纯 OCR。
MYINVOIS_ENABLED=false
# 网关（piaozone / kdfpy 国际电子发票平台）
#   SIT  http://api-sit.piaozone.com/gjfp
#   生产 https://api.kdfpy.com/gjfp
MYINVOIS_GATEWAY_BASE_URL=
MYINVOIS_GATEWAY_CLIENT_ID=
MYINVOIS_GATEWAY_CLIENT_SECRET=
MYINVOIS_GATEWAY_COMPANY_ID=
# 并行查验的宽限期：OCR 已返回后，最多再为查验等多久（秒）。
# 网关 verify 是同步转调税局，延迟偶发 10s+，用它兜住响应尾延迟。
MYINVOIS_JOIN_GRACE_S=8.0
# 二维码扫描段的刹车（与下方 verify 循环的上限相互独立）。扫描是纯 CPU 的
# 整页渲染，跑在线程池里且无法 cancel —— 无上限时一份上百页 PDF 会占死线程
# 数十秒，让后续查验全卡在 JOIN_GRACE 超时（增强静默失效，CPU 却在空烧）。
MYINVOIS_SCAN_MAX_PAGES=16
MYINVOIS_SCAN_BUDGET_S=12.0
# 单次请求最多查验几条二维码 / 查验总时间预算（秒）
MYINVOIS_MAX_LOOKUPS=12
MYINVOIS_BUDGET_S=30
# 单次网关调用超时（秒）；仅 VALID 状态的单据才允许覆盖 OCR
MYINVOIS_TIMEOUT_S=15
MYINVOIS_REQUIRE_VALID=true
